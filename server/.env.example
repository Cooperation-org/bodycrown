PORT=8065
# Reverse proxies whose X-Forwarded-For is trusted: the proxy in front of this server
TRUSTED_PROXIES=loopback,<proxy-address>
# Browser origins allowed to call the API, comma-separated
CORS_ORIGINS=https://bodycrown.vercel.app,http://localhost:5173
# App runtime role (SELECT/INSERT/UPDATE/DELETE only)
DATABASE_URL=postgresql://<app_user>:<password>@<db-host>:5432/<database>
# Owner role, used only by `npm run migrate`
MIGRATE_DATABASE_URL=postgresql://<owner_user>:<password>@<db-host>:5432/<database>
# Primary model: any Anthropic-compatible Messages API endpoint
# Opus example: LLM_BASE_URL=https://api.anthropic.com  LLM_MODEL=claude-opus-5-5
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3
LLM_API_KEY=
# Optional fallback model, asked only when the primary fails or exceeds the timeout.
# Set all three or none.
# LLM_FALLBACK_BASE_URL=https://api.minimax.io/anthropic
# LLM_FALLBACK_MODEL=MiniMax-M3
# LLM_FALLBACK_API_KEY=
# Per-request model timeout in ms, applied only when a fallback is set (default 20000)
# LLM_TIMEOUT_MS=20000
# Every conversation needs its secret token. Set this to exactly "false" only for a short
# rollout window while browsers still run the old code. Any other value, or unset, requires it.
# AUTH_REQUIRED=true

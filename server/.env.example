PORT=8065
# Reverse proxies whose X-Forwarded-For is trusted: local nginx, Caddy on the Proxmox host
TRUSTED_PROXIES=loopback,10.0.0.1
# Browser origins allowed to call the API, comma-separated
CORS_ORIGINS=https://bodycrown.vercel.app,http://localhost:5173
# App runtime role (SELECT/INSERT/UPDATE/DELETE only)
DATABASE_URL=postgresql://bodycrown_user:<password>@10.0.0.100:5432/bodycrown
# Owner role, used only by `npm run migrate`
MIGRATE_DATABASE_URL=postgresql://bodycrown_owner:<password>@10.0.0.100:5432/bodycrown
# Any Anthropic-compatible Messages API endpoint
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3
LLM_API_KEY=
